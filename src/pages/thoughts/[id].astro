---
// One page per Thoughts post. The title is the page's h1, which the frame sets in Instrument Serif; the post
// itself reads in Source Serif 4 with the "thoughts" prose styles from tailwind.config.mjs.
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { thoughtsNewestFirst, thoughtPath, type Thought } from '../../scripts/thoughts';
import { dayOf } from '../../scripts/dated';
import '../../styles/thoughts.css';

type Neighbour = { title: string; href: string };

// Each post also gets its neighbours in the newest-first list: the newer one before it and the older one after.
// Astro runs this on its own, apart from the rest of the frontmatter, so it keeps its helper inside.
export async function getStaticPaths() {
  const posts = await thoughtsNewestFirst();
  const neighbour = (post: Thought | undefined): Neighbour | undefined => post && { title: post.data.title, href: thoughtPath(post) };
  return posts.map((post, i) => ({
    params: { id: post.id },
    props: { post, newer: neighbour(posts[i - 1]), older: neighbour(posts[i + 1]) },
  }));
}

const { post, newer, older } = Astro.props as { post: Thought; newer?: Neighbour; older?: Neighbour };
const { Content } = await render(post);
const day = dayOf(post.data.date);
---

<Layout title={`${post.data.title} | gui's website`} description={post.data.summary} reading>
  <link slot="head" rel="preload" href="/fonts/source-serif-4-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
  <article class="w-full max-w-[624px] px-4 pt-4 sm:pt-8">
    <header class="mb-6">
      <!-- The title row leaves room on the right for the post's own controls. -->
      <div class="flex items-start gap-4">
        <h1 class="flex-1 min-w-0">{post.data.title}</h1>
      </div>
      <time datetime={day} class="block mt-2 font-reading text-[15px] leading-6 text-secondary">{day}</time>
    </header>
    <div class="prose prose-thoughts max-w-none font-reading">
      <Content />
    </div>
    {(newer || older) && (
      <!-- Previous goes back up the list to the newer post, Next on to the older one, each only when it exists. -->
      <nav aria-label="more thoughts" class="mt-10 pt-6 border-t border-[color:var(--reading-rule)] grid grid-cols-2 gap-4 font-reading">
        {newer && (
          <a href={newer.href} class="neighbour flex flex-col justify-center min-h-11 py-1 justify-self-start">
            <span class="text-sm text-secondary">Previous</span>
            <span class="neighbour-title text-primary">{newer.title}</span>
          </a>
        )}
        {older && (
          <a href={older.href} class="neighbour flex flex-col justify-center min-h-11 py-1 col-start-2 justify-self-end text-right">
            <span class="text-sm text-secondary">Next</span>
            <span class="neighbour-title text-primary">{older.title}</span>
          </a>
        )}
      </nav>
    )}
  </article>
</Layout>


<style>
  .neighbour:hover .neighbour-title {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
