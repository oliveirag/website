---
// The Sky: the region above the Field where page content sits and scrolls. It stops short of the grass
// and fades its content out over its last stretch, so nothing ever touches the Field.
// It shows a "scroll" hint while there is more below and the visitor has not scrolled yet.
---

<main id="sky" class="sky no-scrollbar">
  <slot />
</main>
<div id="scroll-hint" class="scroll-hint" aria-hidden="true" data-shown="false">
  <span>scroll</span>
  <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M8 3v10M3.5 8.5 8 13l4.5-4.5" />
  </svg>
</div>

<style is:global>
  :root {
    /* Space between the Sky's bottom edge and the grass line. */
    --sky-gap: 12px;
    /* The stretch at the bottom of the Sky over which content fades out. */
    --sky-fade: 96px;
    /* Room at the top for the controls that sit over the Sky. */
    --sky-top-inset: 48px;
  }

  .sky {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: calc(var(--field-height) + var(--sky-gap));
    z-index: 10;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding-top: var(--sky-top-inset);
    /* Lets the last content scroll clear of the fade. */
    padding-bottom: var(--sky-fade);
    /* Anchors and find land below the top controls and above the fade. */
    scroll-padding-top: var(--sky-top-inset);
    scroll-padding-bottom: var(--sky-fade);
    -webkit-mask-image: linear-gradient(to bottom, #000 calc(100% - var(--sky-fade)), transparent calc(100% - 16px));
    mask-image: linear-gradient(to bottom, #000 calc(100% - var(--sky-fade)), transparent calc(100% - 16px));
  }

  .scroll-hint {
    position: fixed;
    left: 50%;
    bottom: calc(var(--field-height) + var(--sky-gap) + 4px);
    z-index: 20;
    display: flex;
    align-items: center;
    gap: 6px;
    transform: translateX(-50%);
    font-size: 0.75rem;
    line-height: 1rem;
    color: var(--text-secondary);
    pointer-events: none;
    transition:
      opacity var(--duration-base) var(--ease-out),
      visibility 0s linear;
  }

  .scroll-hint[data-shown='false'] {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--duration-base) var(--ease-out),
      visibility 0s linear var(--duration-base);
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-hint,
    .scroll-hint[data-shown='false'] {
      transition: none;
    }
  }
</style>

<script>
  import { followSky } from '../scripts/sky';

  followSky(document.getElementById('sky')!, document.getElementById('scroll-hint')!);
</script>
