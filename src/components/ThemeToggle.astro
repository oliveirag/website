---
// Switches between Night and Day. Which label shows is decided by CSS on <html data-theme>,
// so the button is right from first paint and its accessible name always says the theme that is on.
import MoonIcon from '../icons/MoonIcon.astro';
import SunIcon from '../icons/SunIcon.astro';
---

<button
  type="button"
  id="theme-toggle"
  class="inline-flex items-center gap-2 h-11 min-w-11 px-3 rounded-md border border-control text-secondary bg-page transition-colors duration-fast ease-out hover:text-primary hover:border-control-hover"
>
  <span class="sr-only">theme: </span>
  <span class="theme-toggle-night inline-flex items-center gap-2"><MoonIcon />night</span>
  <span class="theme-toggle-day inline-flex items-center gap-2"><SunIcon />day</span>
</button>
<!-- Not every screen reader reads out a focused button's new name, so a switch is also announced here. -->
<span id="theme-announcement" role="status" class="sr-only"></span>

<style is:global>
  [data-theme='night'] .theme-toggle-day,
  [data-theme='day'] .theme-toggle-night {
    display: none;
  }
</style>

<script>
  import { read, write } from '../scripts/preferences';

  document.getElementById('theme-toggle')!.addEventListener('click', () => {
    const next = read('theme') === 'night' ? 'day' : 'night';
    write('theme', next);
    document.getElementById('theme-announcement')!.textContent = `${next} is on`;
  });
</script>
