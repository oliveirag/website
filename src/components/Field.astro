---
// The Field: grass pinned to the bottom of the screen. Its box is the grass band, which nothing else may touch.
// The scene inside draws the whole viewport, sky included, and sits behind everything.
// Under it, a CSS gradient in the theme's sky colours shows until the scene draws (or if it can't).
import FieldScene from './FieldScene';
import { skyCustomProperties } from '../scripts/scene-palette';
---

<Fragment set:html={`<style>${skyCustomProperties}</style>`} />
<div class="field-sky" aria-hidden="true"></div>
<!-- Kept across page changes, so the scene keeps running and never remounts. -->
<div id="field" aria-hidden="true" transition:persist="field">
  <FieldScene client:only="react" />
</div>

<style is:global>
  :root {
    /* The share of the viewport the grass fills, and the quality the scene draws at. */
    --field-share: 0.3;
    --field-quality: high;
    --field-height: calc(var(--field-share) * 100vh);
  }

  /* Phones, upright or on their side: less grass, so there is more Sky to read in, drawn at the scene's
     lighter quality. FieldScene reads both values from here, so the band and the scene always agree. */
  @media (max-width: 639px), (max-height: 499px) {
    :root {
      --field-share: 0.22;
      --field-quality: fast;
    }
  }

  .field-sky {
    position: fixed;
    inset: 0;
    z-index: 0;
    background: linear-gradient(to bottom, var(--sky-top), var(--sky-horizon) calc(100% - var(--field-height)));
    pointer-events: none;
  }

  #field {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    height: var(--field-height);
    z-index: 0;
    pointer-events: none;
  }

  /* Without WebGL2 the band shows a still of the grass, rendered from the real scene in each theme (see
     scripts/render-field-stills.mjs). Its top edge is the grass line, so it is anchored there and fills the
     band. Both themes' stills are present, so switching theme never waits for a download. */
  .field-still {
    position: absolute;
    inset: 0;
    background-position: top center;
    background-size: cover;
    background-repeat: no-repeat;
    opacity: 0;
  }

  .field-still-night {
    background-image: url('/images/field/grass-night.webp');
  }

  .field-still-day {
    background-image: url('/images/field/grass-day.webp');
  }

  :root:not([data-theme='day']) .field-still-night,
  :root[data-theme='day'] .field-still-day {
    opacity: 1;
  }
</style>
