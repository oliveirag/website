---
// The Intro: full screen over Home on the first visit in a browser session. It shows only while <html> has
// data-intro (set before first paint by the head script), so a returning visitor never sees it and a page
// without JavaScript never shows it. Bloom Type draws into the stage after first paint (src/scripts/intro.ts).
// When it ends, the name travels into Home's heading in the flight layer, above the fading cover.
import { introCustomProperties } from '../scripts/scene-palette';
---

<Fragment set:html={`<style>${introCustomProperties}</style>`} />
<div id="intro" class="intro" role="dialog" aria-modal="true" aria-label="intro" aria-describedby="intro-hint" tabindex="-1">
  <div class="intro-stage" data-intro-stage></div>
  <p id="intro-hint" class="intro-hint">click, tap or press any key to continue</p>
  <button type="button" class="intro-skip" data-intro-skip>skip intro</button>
</div>
<div class="intro-flight" data-intro-flight aria-hidden="true"></div>

<style is:global>
  :root {
    /* The move into Home is long for UI motion, so it eases out more gently than --ease-out, which would
       finish most of a 900ms move in its first 200ms. */
    --intro-travel-ease: cubic-bezier(0.33, 1, 0.68, 1);
  }

  .intro {
    display: none;
  }

  :root[data-intro] .intro {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 100;
    /* The Field's own sky (see Field.astro), without the grass. The drawing blends onto it. */
    background: linear-gradient(to bottom, var(--sky-top), var(--sky-horizon) calc(100% - var(--field-height)));
    color: var(--intro-ink);
    opacity: 1;
    cursor: pointer;
    transition: opacity var(--intro-fade, 400ms) var(--ease-out);
  }

  /* Leaving, the cover fades off Home and lets every press, scroll and tap through to it at once. */
  :root[data-intro='leaving'] .intro {
    opacity: 0;
    pointer-events: none;
  }

  /* The Field rises from below the screen as the Intro leaves (900ms, as in src/scripts/intro.ts). Under
     reduced motion it stays where it is. */
  @media (prefers-reduced-motion: no-preference) {
    :root[data-intro='showing'] #field {
      transform: translateY(100%);
    }
    :root[data-intro='leaving'] #field {
      transition: transform 900ms var(--intro-travel-ease);
    }
  }

  /* The name on its way to the heading: real text above the fading cover, one piece per word. */
  .intro-flight {
    display: none;
  }

  :root[data-intro='leaving'] .intro-flight {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 101;
    overflow: hidden;
    pointer-events: none;
  }

  .intro-flight-line {
    position: absolute;
    left: 0;
    top: 0;
    font-family: var(--font-serif);
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0;
    white-space: pre;
  }

  .intro-flight-word {
    display: inline-block;
    position: relative;
    transform-origin: 0 0;
  }

  /* The same word in the heading's colour, over the word in the Intro's ink. It fades in as the word travels. */
  .intro-flight-settled {
    position: absolute;
    left: 0;
    top: 0;
    opacity: 0;
  }

  /* The heading waits, hidden, while its words are in flight. */
  #sky h1[data-intro-flying] {
    opacity: 0;
  }

  .intro:focus {
    outline: none;
  }

  /* The drawing blends onto the Intro's sky as one layer, so it can drift off without its background showing. */
  .intro-stage {
    position: absolute;
    inset: 0;
    mix-blend-mode: var(--intro-blend);
  }

  .intro-lines {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .intro-line {
    position: absolute;
  }

  .intro-hint {
    position: absolute;
    left: 50%;
    bottom: 32px;
    transform: translateX(-50%);
    margin: 0;
    max-width: calc(100% - 32px);
    font-size: 0.875rem;
    line-height: 1.25rem;
    text-align: center;
    opacity: 0.75;
    /* The flowers keep leaning toward a pointer that passes over the hint. */
    pointer-events: none;
  }

  .intro-skip {
    position: absolute;
    right: 16px;
    top: 16px;
    min-width: 44px;
    min-height: 44px;
    padding: 0 10px;
    border-radius: 8px;
    font-size: 0.875rem;
    line-height: 1.25rem;
    color: inherit;
    background: transparent;
    opacity: 0.75;
    cursor: pointer;
    transition: opacity var(--duration-fast) var(--ease-out);
  }

  .intro-skip:hover,
  .intro-skip:focus-visible {
    opacity: 1;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (min-width: 640px) {
    .intro-skip {
      right: 32px;
      top: 24px;
    }
  }

  /* Home's heading takes focus when the Intro ends. It isn't a control, so it shows no focus ring. */
  [data-intro-focus]:focus {
    outline: none;
  }
</style>

<script>
  import { introState, startIntro } from '../scripts/intro';
  import { onEveryPage } from '../scripts/page-lifecycle';

  onEveryPage(() => {
    const intro = document.getElementById('intro');
    if (!intro || introState() !== 'showing') return;
    return startIntro(intro);
  });
</script>
