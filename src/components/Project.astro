---
interface Props {
    title: string;
    languages: string;
    description: string;
    github?: string;
    url?: string;
    image?: string;
}
import GithubIcon from '../icons/GithubIcon.astro';
import ExternalLink from '../icons/ExternalLink.astro';

const { title, description, github, url, image } = Astro.props;
const href = url ?? github;
const isGithub = href?.startsWith('https://github.com');
// The card's icon sits in its top-right corner, 19px down (1px border + 16px padding + 2px, level with the first
// title line) and 17px in, while the title and description are centred on the logo. Absolute offsets start inside
// the border, so they read top-[18px] right-[16px].
// A project with a site and its source: the card opens the site and the GitHub icon is its own link. Links can't
// nest, so that icon is a sibling laid over the card's icon spot: its 44px square is centred on the 24px spot, so
// top-[9px] right-[7px].
const sourceLink = github && github !== href ? github : undefined;
---

<div class="relative">
    <a
        href={href}
        target="_blank"
        rel="noreferrer"
        class="project glow-border interactive group relative flex items-center gap-4 rounded-lg p-4 min-h-32 h-full w-full overflow-hidden"
    >
        {image && <img src={image} alt="" class="mx-2 w-14 h-14 rounded aspect-square shrink-0" />}
        <span class:list={['absolute top-[18px] right-[16px] flex w-6 h-6 items-center justify-center text-icon-secondary group-hover:text-icon-primary transition-colors duration-fast ease-out', { invisible: sourceLink }]} aria-hidden="true">
            {isGithub || sourceLink ? <GithubIcon class="w-6 h-6" /> : <ExternalLink class="w-4 h-4" />}
        </span>
        <!-- Not full height, so the card's items-center centres the title and description on the logo. The title row's
             pr-8 keeps the title clear of the corner icon; the description's w-5/6 already does. -->
        <div class="w-full min-w-0">
            <div class="mb-2 flex w-full items-center pr-8">
                <span class="flex items-center gap-1 font-bold text-lg sm:text-xl text-primary truncate">
                    {title}
                </span>
            </div>
            <!-- No line clamp: on a phone a long description wraps to more lines and the card grows to fit it. -->
            <p class="text-secondary text-sm w-5/6">{description}</p>
        </div>
        <span class="sr-only">{isGithub ? 'view source on github' : 'open project'}</span>
    </a>
    {sourceLink && (
        <a
            href={sourceLink}
            target="_blank"
            rel="noreferrer"
            aria-label={`${title} source on github`}
            class="absolute top-[9px] right-[7px] flex w-11 h-11 items-center justify-center rounded-md text-icon-secondary hover:text-icon-primary transition-colors duration-fast ease-out"
        >
            <GithubIcon class="w-6 h-6" />
        </a>
    )}
</div>

<script>
  import { initializeHover } from '../scripts/hover.js';
  initializeHover('.project');
</script>
