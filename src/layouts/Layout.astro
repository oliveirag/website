---
import SpeedInsights from '@vercel/speed-insights/astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Field from '../components/Field.astro';
import Sky from '../components/Sky.astro';
import { themeBeforePaintScript, themeColors } from '../scripts/preferences';
interface Props {
  title: string;
}

const { title } = Astro.props;
import '../styles/scrollbar.css';
import '../styles/tokens.css';
---

<html lang="en" class="no-scrollbar" data-theme="night">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="peep the website">
    <title>{title}</title>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <meta name="theme-color" content={themeColors.night}>
    <link rel="icon" href="/images/globe.png" type="image/png">
    <script is:inline set:html={themeBeforePaintScript} />
  </head>
  <body class="bg-page text-primary no-scrollbar overflow-x-hidden font-sans">
    <Field />
    <!-- The theme toggle sits top right, over the Sky, until the navigation gives it its final place. -->
    <div class="fixed top-0 inset-x-0 z-20 flex justify-end max-w-5xl mx-auto px-4 sm:px-8 pt-4 pointer-events-none">
      <div class="pointer-events-auto"><ThemeToggle /></div>
    </div>
    <Sky>
      <slot />
    </Sky>
    <SpeedInsights />
    <script>
      import { followTheme } from '../scripts/theme';

      followTheme();
    </script>
  </body>
</html>
