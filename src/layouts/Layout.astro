---
// The site frame every page shares: the Field, the navigation with the theme toggle, the Sky the page
// fills and the sound control. Pages change through Astro's client router, so the Field, the Ambience and
// the preferences carry over.
import { ClientRouter } from 'astro:transitions';
import SpeedInsights from '@vercel/speed-insights/astro';
import Navigation from '../components/Navigation.astro';
import Field from '../components/Field.astro';
import Sky from '../components/Sky.astro';
import SoundControl from '../components/SoundControl.astro';
import { themeBeforePaintScript, mutedBeforePaintScript, introBeforePaintScript, themeColors } from '../scripts/preferences';
import { oldLinksBeforePaintScript } from '../scripts/old-links';
interface Props {
  title: string;
}

const { title } = Astro.props;
import '../styles/scrollbar.css';
import '../styles/tokens.css';
import '../styles/type.css';
---

<!-- Pages swap with no animation: the Field carries on as it is, and input is never held up by a fade. -->
<html lang="en" class="no-scrollbar" data-theme="night" data-sound="locked" transition:animate="none">
  <head>
    <script is:inline set:html={oldLinksBeforePaintScript} />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="peep the website">
    <title>{title}</title>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- The serif for my name and page titles: preloaded so the Home heading shows in it from the start. -->
    <link rel="preload" href="/fonts/instrument-serif-latin.woff2" as="font" type="font/woff2" crossorigin>
    <meta name="theme-color" content={themeColors.night}>
    <link rel="icon" href="/images/globe.png" type="image/png">
    <script is:inline set:html={themeBeforePaintScript} />
    <script is:inline set:html={mutedBeforePaintScript} />
    <script is:inline set:html={introBeforePaintScript} />
    <!-- Google tag (gtag.js). In the head and the same on every page, so it runs once per visit. -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-6LCTQSHDRD"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-6LCTQSHDRD');
    </script>
    <ClientRouter />
  </head>
  <body class="bg-page text-primary no-scrollbar overflow-x-hidden font-sans">
    <!-- Home's Intro goes here, outside the Sky, whose fade mask would clip it. -->
    <slot name="intro" />
    <Field />
    <Navigation />
    <Sky>
      <slot />
    </Sky>
    <SoundControl />
    <SpeedInsights />
    <script>
      import { followTheme } from '../scripts/theme';
      import { newAddressFor } from '../scripts/old-links';

      followTheme();

      // An old link typed or followed while Home is already open. The hash change leaves a history entry
      // the client router can't navigate from, so this one loads the page in full.
      window.addEventListener('hashchange', () => {
        const to = newAddressFor(location.pathname, location.hash);
        if (to) location.replace(to);
      });

      // An old link followed from another page, which the client router loads without a hash change.
      document.addEventListener('astro:before-preparation', (event) => {
        const to = newAddressFor(event.to.pathname, event.to.hash);
        if (to) event.to = new URL(to, event.to);
      });
    </script>
  </body>
</html>
